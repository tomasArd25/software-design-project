             <property name="styleSheet">
              <string notr="true">QWidget{
	color:white;
	font-size:9pt;
	background-color:#202020;
	border-radius:25px;
}
/* combo box*/
QComboBox{
	height:25px;
	border:1px solid #6A6B6C;
	border-radius:5px;
	padding-left:5px;
}
QComboBox:drop-down{
	border:0px;
}
QComboBox:down-arrow{
	image: url(:/newPrefix/main_res/down-arrow_white.png);
	width:12px;
}
QComboBox:hover{
	border:2px solid #6A6B6C;
	background-color:#3d3d3d;
}
QComboBox:focus{
	border:1px solid #8274FF;
}
QComboBox:on{
	border:1px solid #8274FF;
}
QComboBox QListView{
	font-size:9px;
	border:1px solid #8274FF;
	padding:5px;
	outline:none;
	border-radius:5px;
}
QComboBox QListView:item{
	padding-left:5px;
	background-color: #FFFFFF;
}
QComboBox QListView:item:hover{
	background-color: #202020;
}
QComboBox QScrollBar:vertical{
	width:12px;
	margin: 0px 0px 0px 0px;
	border:none;
	background:none;
	background-color: #202020;
}
QComboBox QScrollBar:handle:vertical {
	background-color: #8274FF;
	border-radius:5px;
	min-height:5px;
}
QComboBox QScrollBar::add-line:vertical,
QComboBox QScrollBar::sub-line:vertical,
QComboBox QScrollBar::up-arrow:vertical,
QComboBox QScrollBar::down-arrow:vertical,
QComboBox QScrollBar::add-page:vertical,
QComboBox QScrollBar::sub-page:vertical {
	background: none;
	height: 0px;
	width: 0px;
}
/* combo box*/
/*qline*/
QLineEdit{
	height:25px;
	border:1px solid #6A6B6C;
	border-radius:5px;
	font-size:9pt;
	padding-left:5px;
	max-width:150px;
}
QLineEdit:hover{
	border:2px solid #6A6B6C;
	background-color:#3d3d3d;
}
QLineEdit:focus{
	border:1px solid #8274FF
}
/*qline*/
/*qdate*/
QDateEdit{
	height:25px;
	border:1px solid #6A6B6C;
	border-radius:5px;
	padding-left:5px;
}
QDateEdit:hover{
	border:2px solid #6A6B6C;
	background-color:#3d3d3d;
}
QDateEdit:focus{
	border:1px solid #8274FF
}
QDateEdit::up-button, QDateEdit::down-button {
	width: 0px;
	height: 0px;
	border: none;
}
QDateEdit:drop-down{
	border:0px;
}
QDateEdit:down-arrow{
	image: url(:/icons/down-arrow_white.png);
	width:12px;
}
/*qdate*/
/*qspin*/
QSpinBox{
	height:25px;
	border:1px solid #6A6B6C;
	border-radius:5px;
	padding-left:5px;
}
QSpinBox:hover{
	border:2px solid #6A6B6C;
	background-color:#3d3d3d;
}
QSpinBox:focus{
	border:1px solid #8274FF
}
QSpinBox::up-button, QSpinBox::down-button {
	width: 0px;
	height: 0px;
	border: none;
}
/*qspin*/


</string>
